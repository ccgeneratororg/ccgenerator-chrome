{
  "manifest_version": 3,
  "name": "__MSG_appName__",
  "short_name": "CC Generator",
  "version": "1.0.0",
  "default_locale": "en",
  "description": "__MSG_appDesc__",
  "homepage_url": "https://ccgenerator.org/",

  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "action": {
    "default_popup": "popup.html",
    "default_title": "__MSG_appName__",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "background": {
    "service_worker": "background.js"
  },

  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },

  "permissions": [
    "storage",
    "contextMenus",
    "activeTab",
    "scripting"
  ],

  "optional_permissions": [
    "clipboardRead"
  ],

  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+C" }
    },
    "fill-test-card": {
      "suggested_key": { "default": "Alt+Shift+F" },
      "description": "__MSG_cmdFillDesc__"
    }
  },

  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
